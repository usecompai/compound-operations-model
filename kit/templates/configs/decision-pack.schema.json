{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laigam.com/schemas/decision-pack-v0.2.json",
  "title": "Compai Decision Pack",
  "type": "object",
  "required": [
    "kind",
    "api_version",
    "id",
    "loop_id",
    "run_id",
    "mode",
    "generated_at",
    "source_refs",
    "capability_refs",
    "observations",
    "recommendation",
    "model_adapter",
    "outcome_contract",
    "verification",
    "terminal_state",
    "stop_reason"
  ],
  "properties": {
    "kind": {"const": "DecisionPack"},
    "api_version": {"const": "compai/v0.2"},
    "id": {"type": "string", "minLength": 1},
    "loop_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["shadow", "approved_canary", "production"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "system", "observed_at", "freshness_sla", "sha256", "canonical"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "system": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "freshness_sla": {"type": "string", "pattern": "^P"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "canonical": {"type": "boolean"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "capability_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observations": {"type": "object"},
    "recommendation": {
      "type": ["object", "null"],
      "properties": {
        "action_type": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "rationale": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "confidence": {"enum": ["high", "medium", "low"]},
        "owner": {"type": "string", "minLength": 1},
        "authority": {"enum": ["internal_only", "approval_required", "authorized"]},
        "proposed_parameters": {"type": "object"}
      },
      "required": ["action_type", "summary", "rationale", "confidence", "owner", "authority", "proposed_parameters"],
      "additionalProperties": false
    },
    "model_adapter": {
      "type": "object",
      "required": ["provider", "model", "role", "affects_authority"],
      "properties": {
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "role": {"enum": ["none_deterministic_policy", "optional_narrative", "bounded_classification"]},
        "affects_authority": {"const": false}
      },
      "additionalProperties": false
    },
    "outcome_contract": {
      "type": "object",
      "required": ["primary_metric", "baseline", "guardrails", "attribution_method", "observation_window", "follow_up_due_at", "status"],
      "properties": {
        "primary_metric": {"type": "string", "minLength": 1},
        "baseline": {"type": "object"},
        "guardrails": {"type": "array", "items": {"type": "object"}},
        "attribution_method": {"type": "string", "minLength": 1},
        "observation_window": {"type": "string", "pattern": "^P"},
        "follow_up_due_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["pending_approval", "pending_action", "measurement_pending", "not_applicable"]}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["source_freshness_passed", "schema_passed", "external_mutations", "action_authorized"],
      "properties": {
        "source_freshness_passed": {"type": "boolean"},
        "schema_passed": {"type": "boolean"},
        "external_mutations": {"const": 0},
        "action_authorized": {"type": "boolean"},
        "checks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "terminal_state": {"enum": ["clean_noop", "approval_required", "blocked", "failed"]},
    "stop_reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
